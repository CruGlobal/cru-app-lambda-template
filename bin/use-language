#!/usr/bin/env bash
# Activate one language for this Cru app.
#
#   bin/use-language <nodejs|ruby|python>
#
# Copies the chosen stack from stacks/<lang>/ to the repo root (Dockerfile,
# build.sh, .tool-versions, dependency manifest, and a minimal app that already
# answers the health check), writes a matching .github/dependabot.yml for that
# language, then removes the other stacks so the repo holds exactly one
# language. Run this ONCE near the start of a new app, then commit. See
# AGENTS.md.
set -euo pipefail

lang="${1:-}"
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

# Map the language to its dependabot package ecosystem.
case "$lang" in
  nodejs) eco="npm" ;;
  ruby) eco="bundler" ;;
  python) eco="pip" ;;
  *)
    echo "Usage: bin/use-language <nodejs|ruby|python>" >&2
    exit 1
    ;;
esac

if [ ! -d "stacks/$lang" ]; then
  echo "No stack for '$lang'. (Already activated? stacks/ is removed after activation.)" >&2
  exit 1
fi

echo "→ Activating the $lang stack…"
# Copy everything in the stack — including dotfiles like .tool-versions.
cp -R "stacks/$lang/." .

# Write the dependency-update config for the language now at the root. This is
# for THIS app (the resulting repo) — the template itself ships no
# dependabot.yml. The dependabot-auto-merge workflow merges grouped minor/patch
# bumps once CI is green; major bumps stay per-PR for a real migration check.
echo "→ Writing .github/dependabot.yml for $lang ($eco)…"
mkdir -p .github
cat > .github/dependabot.yml <<EOF
# Dependency updates for this app — generated by bin/use-language ($lang).
version: 2

updates:
  - package-ecosystem: "$eco"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 5
    groups:
      $eco-dependencies:
        patterns:
          - "*"
        update-types:
          - "minor"
          - "patch"
    commit-message:
      prefix: "deps"
      include: "scope"

  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 3
    groups:
      github-actions:
        patterns:
          - "*"
        update-types:
          - "minor"
          - "patch"
    commit-message:
      prefix: "ci"
      include: "scope"

  - package-ecosystem: "docker"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 2
    commit-message:
      prefix: "docker"
      include: "scope"
EOF

echo "→ Removing stacks/ and this script (one language now lives at the root)…"
rm -rf stacks
rm -f bin/use-language
rmdir bin 2>/dev/null || true

echo "✓ Done — the repo root now holds your $lang app."
echo "  Next: review the files and commit. See AGENTS.md to run it locally and"
echo "  deploy (open a PR off main, then add the 'On Staging' label)."
